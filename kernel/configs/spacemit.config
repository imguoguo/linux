CONFIG_KGDB=y
CONFIG_KGDB_KDB=y
CONFIG_KDB_KEYBOARD=y
CONFIG_PHY_SPACEMIT_K1_USB2=y
CONFIG_USB_DWC3=y
CONFIG_USB_ONBOARD_DEV=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30

# K3 display (DPU + Innosilicon eDP/DP + pwm-backlight)
# DRM=y is required so DRM_SPACEMIT can be =y (builtin) instead of =m.
# PWM_PXA + BACKLIGHT_PWM drive the eDP backlight via PWM18 on K3 Pico-ITX;
# both must be builtin so they probe from the minimal initramfs that ships
# without /lib/modules.
CONFIG_DRM=y
CONFIG_DRM_SPACEMIT=y
CONFIG_SPACEMIT_INNO_DP=y
CONFIG_PHY_SPACEMIT_K3_INNO_DP=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_PWM_PXA=y
CONFIG_BACKLIGHT_PWM=y

# K3 v1 does not ship a DP audio path or any other on-SoC audio
# consumer. Drop the ASoC framework so we do not drag in the
# unused subsystem; a future series that wires up DP audio (or
# any other I2S codec) can lift these "is not set" lines.
# CONFIG_SND is not set
# CONFIG_SND_SOC is not set
